# px environment. Copy to ~/.px/env (preferred) or .px/env (this project only).
#
# Load order, lowest precedence first:
#   ~/.px/env  <  <project>/.px/env  <  process environment
# The process environment wins outright, so a DEEPSEEK_API_KEY already exported
# in your shell silently overrides anything written in these files. If a key is
# not the one you expect, check `env | grep DEEPSEEK` before editing a file.
#
# Format is deliberately dumb: KEY=value, one per line, # for comments,
# surrounding single or double quotes stripped. No interpolation, no export.


# ---------------------------------------------------------------------------
# USE A DEDICATED DEEPSEEK KEY. This is not a style preference.
# ---------------------------------------------------------------------------
# px accounts every call from the usage payload and writes it to a local ledger.
# The only independent check on that arithmetic is your DeepSeek account
# balance: spend the key on nothing else, and the balance delta over a day must
# equal the ledger sum over the same day. If it does not, either px is
# mis-reading usage or you were billed for something px never saw — and both are
# worth knowing.
#
# On a key shared with a chat client, another agent, or a side project, that
# reconciliation is impossible. The balance moves for reasons px cannot see, so
# every discrepancy is unattributable and the ledger becomes a number you have
# to take on faith. Mint a second key; they are free.
#
# Read by loadConfig as PX_DEEPSEEK_API_KEY, falling back to DEEPSEEK_API_KEY.
# Prefer the PX_-prefixed name: it is the one that cannot collide with the key
# some other tool exported into your shell.
PX_DEEPSEEK_API_KEY=sk-replace-me

# Fallback name. Only set this if something else in your toolchain requires it;
# setting both means the PX_ one wins.
# DEEPSEEK_API_KEY=sk-replace-me


# ---------------------------------------------------------------------------
# Budget
# ---------------------------------------------------------------------------
# Hard per-task ceiling in USD. The run stops with outcome "budget" when the
# ledger crosses it. Default 0.15 is roughly 10x the reference 30-turn session
# ($0.0149 off-peak), so it is a runaway tripwire, not a working constraint —
# if you are hitting it regularly, something is looping, not merely thinking.
# Remember peak hours double every rate, so the same work costs twice as much
# against the same ceiling Mon-Fri 01:00-04:00 and 06:00-10:00 UTC.
# PX_BUDGET_USD=0.15

# Hard stop on assistant turns, independent of budget. Catches the cheap
# infinite loop that would never trip a dollar ceiling.
# PX_MAX_STEPS=40


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# WRITE THESE ABSOLUTE. A leading ~ is NOT expanded: these files are parsed by
# px, not sourced by your shell, so "~/.px/ledger.db" is taken literally and px
# creates a directory actually named "~" in the current working directory. The
# defaults below are shown with ~ because loadConfig builds them from homedir()
# itself; if you override one, spell out /Users/you/... or /home/you/...
#
# SQLite ledger: one row per API call, plus per-run rollups. Gitignored via
# *.db and the *.db-wal / *.db-shm sidecars if you point it inside a repo —
# bun:sqlite runs it in WAL mode, so those two files exist alongside the .db.
# Default: ~/.px/ledger.db
# PX_LEDGER_PATH=/absolute/path/to/ledger.db

# Where px creates the git worktrees it edits in. One directory per run; the
# containment boundary for everything the agent does.
# Default: ~/.px/worktrees
# PX_WORKTREE_ROOT=/absolute/path/to/worktrees


# ---------------------------------------------------------------------------
# Context
# ---------------------------------------------------------------------------
# Compaction threshold in prompt tokens. The default is set by the 128,000-token
# per-request cache-write cap, not by the 1,048,576-token context window: past
# that cap the tail of the prompt stops being cacheable at all, so growing the
# conversation further costs full miss rate on every subsequent turn. 120,000
# leaves headroom for the turn that crosses it.
# PX_COMPACT_AT=120000
